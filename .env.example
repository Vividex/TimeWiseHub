# TimeWiseHub environment variables (NAMES only — never commit real values).
# Copy to .env.local for dev; set the same names in Vercel for production
# (`vercel env add NAME production`). A missing/invalid key surfaces as a 5xx
# from the relevant API route at runtime, NOT as a build error.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only; bypasses RLS — never expose client-side

# --- AI ---
ANTHROPIC_API_KEY=                  # assistant (/api/assistant)
ELEVENLABS_API_KEY=                 # text-to-speech (/api/tts). Free tier can't use
                                    # library/professional voices via API — use a
                                    # premade voice id, or the app falls back to
                                    # browser SpeechSynthesis.

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# --- Web push (VAPID) ---
VAPID_SUBJECT=                      # e.g. mailto:support@vividex.au
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Client email messaging (Resend) ---
RESEND_INBOUND_DOMAIN=       # e.g. inbound.timewisehub.com.au — set up as a receiving domain in Resend
RESEND_WEBHOOK_SECRET=       # from the webhook's signing secret in the Resend dashboard (starts with whsec_)

# --- App / misc ---
NEXT_PUBLIC_APP_URL=                # e.g. https://www.timewisehub.com.au
CRON_SECRET=                        # guards /api/notifications/* cron routes

# --- Video calls (Daily.co) ---
DAILY_API_KEY=                      # from Daily.co dashboard > Developers
