# Normalise line endings to LF in the repo (stops the "LF will be replaced by
# CRLF" warnings on every commit from Windows). Working tree can stay CRLF.
* text=auto eol=lf

# Binary assets — never normalise.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.pdf binary
